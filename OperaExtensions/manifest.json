{
  "name": "Collect",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "contextMenus",
    "native-file-systems"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png"
  }
}
